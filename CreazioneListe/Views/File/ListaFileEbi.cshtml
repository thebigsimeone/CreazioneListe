@model List<System.IO.FileInfo>
@{
    var tenant = ViewBag.Tenant ?? "EBI";
}

<h2>Lista File Generati per Tenant: @tenant</h2>
<table class="table">
    <thead>
        <tr>
            <th>Nome File</th>
            <th>Azioni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var file in Model)
        {
            <tr>
                <td>@file.Name</td>
                <td>
                    <a asp-controller="File" asp-action="Download" asp-route-tenant="@tenant" asp-route-fileName="@file.Name"
                       class="btn btn-outline-primary download-link" data-file-name="@file.Name">Download</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <button class="btn btn-outline-success" onclick="scaricaTutti()">Download Tutti i File</button>
    <a asp-controller="SelezionaEbi" asp-action="Index" class="btn btn-outline-secondary">Torna alla Selezione</a>
</div>

