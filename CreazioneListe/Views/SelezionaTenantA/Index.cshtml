@model CreazioneListe.Models.FormData
@{
    ViewData["Title"] = "Home Page TENANT_A";
}

<div class="container mt-5">
    <h2>Creazione File Excel per Fornitori TENANT_A</h2>
    <form asp-controller="SelezionaTenantA" asp-action="Submit" method="post">
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="NazCor" name="NazCor" maxlength="3" placeholder="Codice Corrispondente" />
            <label for="NazCor">Codice Corrispondente</label>
        </div>
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="CodCor" name="CodCor" maxlength="5" placeholder="Codice Correlativo" />
            <label for="CodCor">Codice Correlativo</label>
        </div>
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="DaDataAff" name="DaDataAff" maxlength="10" value="@Model.DaDataAff" required placeholder="yyyyMMdd" />
            <label for="DaDataAff">Da Data Affido</label>
        </div>
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="DataAff" name="DataAff" maxlength="10" value="@Model.DataAff" required placeholder="yyyyMMdd" />
            <label for="DataAff">A Data Affido</label>
        </div>
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="CodAcc" name="CodAcc" maxlength="3" placeholder="Accertamento" />
            <label for="CodAcc">Accertamento</label>
        </div>
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="NumLotto" name="NumLotto" maxlength="4" placeholder="Numero Lotto" />
            <label for="NumLotto">Numero Lotto</label>
        </div>
        <div class="form-group text-center mt-4">
            <button type="submit" class="btn btn-outline-info">Elabora</button>
        </div>
    </form>
    <form asp-action="RegistroFile" asp-controller="RegistroFile" method="get">
        <input type="hidden" name="tenant" value="TENANT_A" />
        <input type="hidden" name="dataAff" value="@Model.DataAff" />
        <button type="submit" class="btn btn-outline-primary">Registro File</button>
    </form>
</div>

<style>
    .form-floating .form-control:focus {
        border-color: cornflowerblue; /* Colore del bordo al focus */
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5); /* Aggiungi un effetto di ombreggiatura */
    }
</style>
