@model System.Data.DataTable
@{
    ViewData["Title"] = "Seleziona File EBI";
}
@{
    var columnNamesMap = new Dictionary<string, string>
    {
        { "PBSNCO", "CodNaz" },
        { "PBSCCO", "CodCorr" },
        { "KBARA1", "Fornitore" },
        { "PBSACC", "CodAcc" },
        { "PBSURG", "Urg" },
        { "PBSVALORE", "Val" },
        { "TBIDEC", "Desc" },
        { "TotAcc", "TotAcc" }
    };
}

<div class="container-fluid">
    <h2 class="text-center my-4">Seleziona Dati da Includere nel File Excel EBI</h2>

    <form asp-controller="SelezionaEbi" asp-action="CreaFile" method="post" id="selezionaForm">
        <div class="form-group text-center mb-3">
            <button type="button" class="btn btn-outline-secondary" onclick="selezionaTutte()">Seleziona Tutto</button>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr class="table-primary">
                        <th>Seleziona</th>
                        @foreach (System.Data.DataColumn column in Model.Columns)
                        {
                            <th>@(columnNamesMap.ContainsKey(column.ColumnName) ? columnNamesMap[column.ColumnName] : column.ColumnName)</th>
                        }
                        <th>Formato</th>
                        <th>Unisci</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Rows.Count; i++)
                    {
                        var row = Model.Rows[i];
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" id="rowCheck_@i" name="selectedRows" class="btn-check row-checkbox"
                                       value="@row["PBSNCO"],@row["PBSCCO"],@row["PBSACC"],@row["PBSURG"],@i"
                                       onchange="toggleFormato(@i)">
                                <label class="btn btn-outline-primary btn-check-outlined" for="rowCheck_@i">Seleziona</label>
                            </td>
                            @foreach (var item in row.ItemArray)
                            {
                                <td>@item</td>
                            }
                            <td class="text-center">
                                <select id="formato_@i" class="form-select form-select-sm" disabled>
                                    <option value="B">Base</option>
                                    <option value="R">RT4/RT8</option>
                                    <option value="EREDI">RT6</option>
                                    <option value="CLIENTE">CODCLI</option>
                                </select>
                            </td>
                            <td class="text-center">
                                <input type="checkbox" id="unisci_@i" class="form-check-input" value="false" onchange="toggleUnisci(@i)" disabled />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="form-group text-center mt-4">
            <button type="submit" class="btn btn-outline-primary">Crea File Selezionati</button>
        </div>
    </form>
</div>
