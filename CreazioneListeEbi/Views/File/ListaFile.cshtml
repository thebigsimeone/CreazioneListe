@model List<System.IO.FileInfo>

<div class="container">
    <h2>Elenco dei File Creati</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Nome File</th>
                <th>Dimensione (KB)</th>
                <th>Data di Creazione</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in Model)
            {
                <tr>
                    <td>@file.Name</td>
                    <td>@(file.Length / 1024)</td>
                    <td>@file.CreationTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a asp-controller="File" asp-action="Download" asp-route-fileName="@file.Name" class="btn btn-primary">
                            Scarica
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
