@model System.Data.DataTable

@{
    // Mappatura per sostituire i nomi tecnici delle colonne con nomi più leggibili
    var columnNamesMap = new Dictionary<string, string>
    {
        { "PBSNCO", "Codice Nazionale" },
        { "PBSCCO", "Codice Correlativo" },
        { "KBARA1", "Nome Azienda" },
        { "PBSACC", "Codice Accertamento" },
        { "PBSURG", "Tipo Urgenza" },
        { "PBSVALORE", "Valore" },
        { "TBIDEC", "Descrizione" },
        { "TotAcc", "Totale Accertamenti" }
    };
}

<div class="container">
    <h2>Seleziona Dati da Includere nel File Excel</h2>

    <form asp-controller="Seleziona" asp-action="TestQuery" method="post">
        <table class="table">
            <thead>
                <tr>
                    <th>Seleziona</th>
                    @foreach (System.Data.DataColumn column in Model.Columns)
                    {
                        // Utilizza il nome descrittivo se disponibile, altrimenti usa il nome originale
                        <th>@(columnNamesMap.ContainsKey(column.ColumnName) ? columnNamesMap[column.ColumnName] : column.ColumnName)</th>
                    }
                    <th>Formato</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    <tr>
                        <td>
                            <input type="checkbox" name="selectedRows" value="@row["PBSNCO"],@row["PBSCCO"],@row["PBSACC"],@row["PBSURG"]" />
                        </td>
                        @foreach (var item in row.ItemArray)
                        {
                            <td>@item</td>
                        }
                        <td>
                            @{
                                // Nome univoco per i radio buttons di ogni riga
                                string radioGroupName = "formato";
                            }
                            <input type="radio" name="@radioGroupName" value="B" /> Base
                            <input type="radio" name="@radioGroupName" value="R" /> RT4/RT8
                            <input type="radio" name="@radioGroupName" value="EREDI" /> RT6
                            <input type="radio" name="@radioGroupName" value="CLIENTE" /> CODCLI
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-group text-center mt-4">
            <button type="submit" class="btn btn-primary">Visualizza Dati Selezionati</button>
        </div>
    </form>
</div>
